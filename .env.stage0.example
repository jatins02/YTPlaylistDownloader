# The local CLI reads this project's .env; existing process variables take priority.
# Copy to .env.stage0 only when using Docker --env-file. Never commit populated files.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
MUSICBRAINZ_CONTACT=

# Private S3-compatible bucket; configure a one-day stage0/ lifecycle first.
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_EC2_METADATA_DISABLED=true

# Optional absolute tool paths when binaries are not on PATH.
# FFMPEG_BIN=/path/to/ffmpeg
# FFPROBE_BIN=/path/to/ffprobe
# DENO_BIN=/path/to/deno
